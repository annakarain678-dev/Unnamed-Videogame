; Godot project file for Lenhavu (working title: Unnamed Videogame).

config_version=5

[application]

config/name="Lenhavu"
config/description="A wisp, a world of four species, and the darkness that threatens it."
run/main_scene="res://scenes/forest.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://scripts/input_setup.gd"
DevTools="*res://scripts/dev_tools.gd"

[shader_globals]

spirit_view={
"type": "float",
"value": 1.0
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Thin objects (the camera passes through)"
3d_physics/layer_3="Wisp"

[physics]

common/physics_interpolation=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
